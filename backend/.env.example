# Copy to .env for local overrides. Never commit .env.
RECALLGRAPH_ENVIRONMENT=local
RECALLGRAPH_LOG_LEVEL=INFO
RECALLGRAPH_LOG_JSON=true
# Local Docker Compose database (see ../docker-compose.yml). Use a secret store when deployed.
RECALLGRAPH_DATABASE_URL=postgresql+asyncpg://recallgraph:recallgraph@127.0.0.1:5433/recallgraph
# JWT signing secret. Required (>= 32 random chars) outside local/test, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# RECALLGRAPH_JWT_SECRET=
# Optional: enables AI-worded explanations. Without it, deterministic template explanations.
# RECALLGRAPH_OPENAI_API_KEY=
# RECALLGRAPH_OPENAI_MODEL=gpt-4o-mini
